diff --git a/ha-cards/src/onu-model.ts b/ha-cards/src/onu-model.ts
new file mode 100644
index 0000000..b4512c8
--- /dev/null
+++ b/ha-cards/src/onu-model.ts
@@ -0,0 +1,142 @@
+// qoxi: ONU sticks (8311 firmware, Home Assistant "8311 ONU Monitor" integration)
+// rendered as devices in the Omada network card, plus per-ISP traffic rates
+// derived from their GEM byte counters.
+import type { DeviceRecord, HassEntity, HomeAssistant } from "./ha-types";
+import { toNumber } from "./format";
+
+export const DEFAULT_ONU_PREFIX = "8311_onu_";
+
+interface CounterSample { value: number; ts: number }
+const counterHistory = new Map<string, CounterSample>();
+const counterRate = new Map<string, number>();
+
+function unitScale(entity: HassEntity, table: Record<string, number>): number {
+  const unit = String(entity.attributes.unit_of_measurement ?? "");
+  return table[unit] ?? 1;
+}
+
+const BYTES: Record<string, number> = { B: 1, kB: 1e3, KB: 1e3, KiB: 1024, MB: 1e6, MiB: 1048576, GB: 1e9, GiB: 1073741824, TB: 1e12 };
+const SECONDS: Record<string, number> = { s: 1, min: 60, h: 3600, d: 86400 };
+
+/** Bytes per second from a monotonically increasing byte counter, remembered across renders. */
+function counterRateFor(entity: HassEntity): number {
+  const value = toNumber(entity.state) * unitScale(entity, BYTES);
+  const ts = Date.parse(String(entity.attributes.last_updated ?? entity.last_updated ?? "")) || Date.now();
+  const prev = counterHistory.get(entity.entity_id);
+  if (!prev) {
+    counterHistory.set(entity.entity_id, { value, ts });
+    return counterRate.get(entity.entity_id) ?? 0;
+  }
+  if (ts > prev.ts) {
+    const dt = (ts - prev.ts) / 1000;
+    const rate = value >= prev.value && dt > 0 ? (value - prev.value) / dt : 0;
+    counterHistory.set(entity.entity_id, { value, ts });
+    counterRate.set(entity.entity_id, rate);
+  }
+  return counterRate.get(entity.entity_id) ?? 0;
+}
+
+function stripSuffix(name: string, suffix: string): string {
+  return name.endsWith(suffix) ? name.slice(0, -suffix.length).trim() : name;
+}
+
+/** Collect ONU devices from `sensor.<prefix><serial>_<metric>` entities. */
+export function collectOnuDevices(hass: HomeAssistant, prefix = DEFAULT_ONU_PREFIX, site = ""): DeviceRecord[] {
+  const pattern = new RegExp(`^(sensor|binary_sensor)\\.${prefix.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}([a-z0-9]+)_(.+)$`);
+  const groups = new Map<string, Map<string, HassEntity>>();
+  for (const entity of Object.values(hass.states)) {
+    const match = pattern.exec(entity.entity_id);
+    if (!match) continue;
+    const [, , serial, metric] = match;
+    let group = groups.get(serial!);
+    if (!group) {
+      group = new Map();
+      groups.set(serial!, group);
+    }
+    group.set(metric!, entity);
+  }
+
+  const devices: DeviceRecord[] = [];
+  for (const [serial, group] of groups) {
+    const get = (key: string) => group.get(key);
+    const state = (key: string) => get(key)?.state ?? "";
+    const num = (key: string) => {
+      const entity = get(key);
+      return entity && entity.state !== "unknown" && entity.state !== "unavailable" ? toNumber(entity.state) : 0;
+    };
+    const link = get("pon_link");
+    const name = link ? stripSuffix(String(link.attributes.friendly_name ?? ""), "PON Link") : `ONU ${serial.toUpperCase()}`;
+    const online = link?.state === "on";
+    const ponState = state("pon_state");
+    const uptimeEntity = get("onu_uptime");
+    const inStateEntity = get("pon_time_in_state");
+    const down = get("gem_downstream");
+    const up = get("gem_upstream");
+
+    const metrics: Record<string, number> = {
+      onu_rx_power_dbm: num("rx_power"),
+      onu_tx_power_dbm: num("tx_power"),
+      onu_optic_temp: num("optic_temperature"),
+      onu_cpu_temp: Math.max(num("cpu0_temperature"), num("cpu1_temperature")),
+      onu_voltage: num("voltage"),
+      onu_tx_bias_ma: num("tx_bias_current"),
+      onu_uptime_seconds: uptimeEntity ? num("onu_uptime") * unitScale(uptimeEntity, SECONDS) : 0,
+      onu_time_in_state_seconds: inStateEntity ? num("pon_time_in_state") * unitScale(inStateEntity, SECONDS) : 0,
+      onu_gem_down_bytes: down ? num("gem_downstream") * unitScale(down, BYTES) : 0,
+      onu_gem_up_bytes: up ? num("gem_upstream") * unitScale(up, BYTES) : 0,
+      onu_gem_down_rate: down ? counterRateFor(down) : 0,
+      onu_gem_up_rate: up ? counterRateFor(up) : 0,
+      onu_gem_key_errors: num("gem_key_errors"),
+      onu_fec_corrected: num("gtc_fec_corrected"),
+      onu_fec_uncorrected: num("gtc_fec_uncorrected"),
+      onu_bip_errors: num("gtc_bip_errors"),
+      onu_lods_events: num("gtc_lods_events"),
+      onu_mem_pct: num("memory_usage"),
+      onu_load_1m: num("cpu_load_1m"),
+      onu_alarm: get("pon_alarms")?.state === "on" ? 1 : 0
+    };
+
+    devices.push({
+      key: `onu:${serial}`,
+      name: name || `ONU ${serial.toUpperCase()}`,
+      type: "onu",
+      model: state("part_number") || "ONU",
+      status: online ? "Connected" : "Disconnected",
+      ip: "",
+      mac: state("gpon_serial"),
+      version: state("pon_mode"),
+      site,
+      attrs: {
+        serial: serial.toUpperCase(),
+        pon_state: ponState,
+        pon_previous_state: state("pon_previous_state"),
+        olt_vendor: state("olt_vendor"),
+        gpon_serial: state("gpon_serial"),
+        vendor: state("vendor"),
+        pon_mode: state("pon_mode"),
+        module_type: state("module_type"),
+        firmware_bank: state("active_firmware_bank"),
+        hardware_revision: state("hardware_revision")
+      },
+      metrics,
+      ports: [],
+      radios: [],
+      clients: []
+    });
+  }
+  return devices.sort((a, b) => a.name.localeCompare(b.name));
+}
+
+function tokens(value: string): string[] {
+  return value.toLowerCase().split(/[^a-z0-9]+/).filter((t) => t.length >= 3);
+}
+
+/** Find the ONU that serves a WAN/ISP row by name tokens (e.g. "LinkCom_sfp2" ↔ "ONU LinkCom (sfp2)"). */
+export function findOnuForLink(onus: DeviceRecord[], linkName: string): DeviceRecord | undefined {
+  const want = tokens(linkName);
+  if (want.length === 0) return undefined;
+  return onus.find((onu) => {
+    const have = new Set(tokens(onu.name));
+    return want.every((t) => have.has(t));
+  });
+}
